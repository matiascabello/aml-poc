# LLM_MODE controla qué backend de LLMClient usa la app (src/llm_client.py).
#   fake — default si no se setea nada. Usa el fixture de respuestas
#          precargado en FakeLLMClient (src/llm_client.py), determinístico
#          y sin llamada real a OpenAI: no requiere OPENAI_API_KEY ni red.
#   real — usa RealLLMClient (src/real_llm_client.py), que sí llama a la
#          API de OpenAI. Requiere OPENAI_API_KEY.
LLM_MODE=fake

# Solo requerida si LLM_MODE=real. Sin valor, RealLLMClient falla
# con un RuntimeError explícito en vez de arrancar en un estado inválido.
OPENAI_API_KEY=
